From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Lamprecht <t.lamprecht@proxmox.com>
Date: Wed, 2 Sep 2026 19:55:41 +0200
Subject: [PATCH] auth/cephx: check cipher policy and derive session keys per
 candidate

The monitor accepts either the active or the pending key of an entity,
but cipher policy and the session key types were taken from the active
key regardless of which candidate matched. A disallowed pending cipher
could thus authenticate through an allowed active key, an allowed
pending key was never tried behind a disallowed active one, and a
client authenticating with a key of a different type received session
keys it might not handle.

Evaluate policy and the challenge per candidate and derive the auth and
initial service session keys from the matched key. Add a unit test for
the candidate handling.

Signed-off-by: Thomas Lamprecht <t.lamprecht@proxmox.com>
---
 src/auth/cephx/CephxServiceHandler.cc      |  84 +++--
 src/test/mon/CMakeLists.txt                |   8 +
 src/test/mon/test_cephx_service_handler.cc | 401 +++++++++++++++++++++
 3 files changed, 450 insertions(+), 43 deletions(-)
 create mode 100644 src/test/mon/test_cephx_service_handler.cc

diff --git a/src/auth/cephx/CephxServiceHandler.cc b/src/auth/cephx/CephxServiceHandler.cc
index 3d17c66e3b6..e86759036d4 100644
--- a/src/auth/cephx/CephxServiceHandler.cc
+++ b/src/auth/cephx/CephxServiceHandler.cc
@@ -193,59 +193,53 @@ int CephxServiceHandler::handle_request(
 	break;
       }
 
-      if (!cipher_is_allowed(eauth.key.get_type())) {
-	ldout(cct, 20) << __func__
-                       << " authentication failed due to unallowed cipher type: "
-                       << CryptoManager::get_key_type_name(eauth.key.get_type()) << dendl;
-        ldout(cct, 30);
-          std::shared_lock rl(lock);
-          auto ciphers = key_server->get_ciphers_allowed();
-          dout_prefix << __func__
-                      << ": ciphers are:";
-          for (auto& cipher : ciphers) {
-            dout_prefix << " " << CryptoManager::get_key_type_name(cipher);
-          }
-        dout_prefix << dendl;
-        ret = -EACCES;
-        break;
-      }
-
       if (!server_challenge) {
 	ret = -EACCES;
 	break;
-      }      
+      }
 
-      uint64_t expected_key;
-      CryptoKey *used_key = &eauth.key;
+      uint64_t expected_key = 0;
+      CryptoKey *used_key = nullptr;
+      bool used_pending = false;
       std::string error;
-      cephx_calc_client_server_challenge(cct, eauth.key, server_challenge,
-					 req.client_challenge, &expected_key, error);
-      if ((!error.empty() || req.key != expected_key) &&
-	  !eauth.pending_key.empty()) {
+      auto key_matches = [&](CryptoKey& key) {
+	if (!cipher_is_allowed(key.get_type())) {
+	  ldout(cct, 20) << __func__
+			 << " authentication candidate has unallowed cipher type: "
+			 << CryptoManager::get_key_type_name(key.get_type())
+			 << dendl;
+	  return false;
+	}
+
+	error.clear();
+	cephx_calc_client_server_challenge(cct, key, server_challenge,
+					 req.client_challenge, &expected_key,
+					 error);
+	if (!error.empty()) {
+	  ldout(cct, 0) << " cephx_calc_client_server_challenge error: "
+			 << error << dendl;
+	  return false;
+	}
+
+	ldout(cct, 20) << " checking key: req.key=" << hex << req.key
+			 << " expected_key=" << expected_key << dec << dendl;
+	return req.key == expected_key;
+      };
+
+      if (key_matches(eauth.key)) {
+	used_key = &eauth.key;
+      } else if (!eauth.pending_key.empty()) {
 	ldout(cct, 10) << "normal key failed for " << entity_name
 		       << ", trying pending_key" << dendl;
-	// try pending_key instead
-	error.clear();
-	cephx_calc_client_server_challenge(cct, eauth.pending_key,
-					   server_challenge,
-					   req.client_challenge, &expected_key,
-					   error);
-	if (error.empty()) {
+	if (key_matches(eauth.pending_key)) {
 	  used_key = &eauth.pending_key;
-	  key_server->note_used_pending_key(entity_name, eauth.pending_key);
+	  used_pending = true;
 	}
       }
-      if (!error.empty()) {
-	ldout(cct, 0) << " cephx_calc_client_server_challenge error: " << error << dendl;
-	ret = -EACCES;
-	break;
-      }
 
-      ldout(cct, 20) << " checking key: req.key=" << hex << req.key
-	       << " expected_key=" << expected_key << dec << dendl;
-      if (req.key != expected_key) {
+      if (!used_key) {
         ldout(cct, 0) << " unexpected key: req.key=" << hex << req.key
-		<< " expected_key=" << expected_key << dec << dendl;
+		<< dec << dendl;
         ret = -EACCES;
 	break;
       }
@@ -276,7 +270,7 @@ int CephxServiceHandler::handle_request(
       info.ticket.init_timestamps(ceph_clock_now(), ttl);
       info.validity.set_from_double(ttl);
 
-      key_server->generate_secret(session_key, eauth.key.get_type());
+      key_server->generate_secret(session_key, used_key->get_type());
 
       info.session_key = session_key;
       if (psession_key) {
@@ -341,7 +335,7 @@ int CephxServiceHandler::handle_request(
 	      key_server->build_session_auth_info(
 		service_id,
 		info.ticket,
-                eauth.key.get_type(),
+                used_key->get_type(),
 		svc_info);
 	      info_vec.push_back(svc_info);
 	    }
@@ -355,6 +349,10 @@ int CephxServiceHandler::handle_request(
 	  encode(extra, *result_bl);
 	}
 
+	if (used_pending) {
+	  key_server->note_used_pending_key(entity_name, eauth.pending_key);
+	}
+
 	// caller should try to finish authentication
 	ret = 1;
       }
