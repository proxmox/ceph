diff --git a/src/test/mon/test_cephx_service_handler.cc b/src/test/mon/test_cephx_service_handler.cc
new file mode 100644
index 00000000000..6310988f72e
--- /dev/null
+++ b/src/test/mon/test_cephx_service_handler.cc
@@ -0,0 +1,401 @@
+// -*- mode:C++; tab-width:8; c-basic-offset:2; indent-tabs-mode:t -*-
+// vim: ts=8 sw=2 smarttab
+
+#include "auth/Auth.h"
+#include "auth/cephx/CephxKeyServer.h"
+#include "auth/cephx/CephxProtocol.h"
+#include "auth/cephx/CephxServiceHandler.h"
+#include "common/ceph_context.h"
+#include "global/global_context.h"
+#include "gtest/gtest.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+using ceph::bufferlist;
+using ceph::decode;
+using ceph::encode;
+
+class TestKeyServer : public KeyServer {
+public:
+  TestKeyServer(CephContext *cct, KeyRing *extra_secrets)
+    : KeyServer(cct, extra_secrets)
+  {
+  }
+
+  void set_allowed_ciphers(std::vector<int> ciphers)
+  {
+    allowed_ciphers = std::move(ciphers);
+  }
+
+  bool is_cipher_allowed(int cipher) const override
+  {
+    return std::find(allowed_ciphers.begin(), allowed_ciphers.end(), cipher) !=
+      allowed_ciphers.end();
+  }
+
+  std::vector<int> get_ciphers_allowed() const override
+  {
+    return allowed_ciphers;
+  }
+
+private:
+  std::vector<int> allowed_ciphers{CEPH_CRYPTO_AES256KRB5};
+};
+
+class CephxServiceHandlerPendingKey : public testing::Test {
+protected:
+  static constexpr uint64_t global_id = 1234;
+
+  KeyRing extra_secrets;
+  TestKeyServer key_server{g_ceph_context, &extra_secrets};
+  EntityName entity_name;
+  EntityAuth entity_auth;
+  uint64_t server_challenge = 0;
+
+  void SetUp() override
+  {
+    ASSERT_TRUE(entity_name.from_str("client.pending-key-test"));
+    ASSERT_TRUE(key_server.generate_secret(entity_auth.key,
+					   CEPH_CRYPTO_AES256KRB5));
+    ASSERT_TRUE(key_server.generate_secret(entity_auth.pending_key,
+					   CEPH_CRYPTO_AES256KRB5));
+    ASSERT_FALSE(entity_auth.key == entity_auth.pending_key);
+    key_server.add_auth(entity_name, entity_auth);
+  }
+
+  std::unique_ptr<CephxServiceHandler> start_session(bool is_new_global_id)
+  {
+    auto handler = std::make_unique<CephxServiceHandler>(g_ceph_context,
+							 &key_server);
+    bufferlist challenge_bl;
+    AuthCapsInfo caps;
+    EXPECT_EQ(0, handler->start_session(entity_name, global_id,
+					is_new_global_id, &challenge_bl,
+					&caps));
+
+    auto challenge_iter = challenge_bl.cbegin();
+    CephXServerChallenge challenge;
+    decode(challenge, challenge_iter);
+    EXPECT_NE(0, challenge.server_challenge);
+    server_challenge = challenge.server_challenge;
+    return handler;
+  }
+
+  uint64_t calculate_response(CryptoKey& key, uint64_t client_challenge)
+  {
+    uint64_t response = 0;
+    std::string error;
+    cephx_calc_client_server_challenge(g_ceph_context, key,
+				       server_challenge, client_challenge,
+				       &response, error);
+    EXPECT_TRUE(error.empty()) << error;
+    return response;
+  }
+
+  CephXAuthenticate make_pending_request()
+  {
+    CephXAuthenticate request{};
+    do {
+      ++request.client_challenge;
+      request.key = calculate_response(entity_auth.pending_key,
+				       request.client_challenge);
+    } while (request.key == calculate_response(entity_auth.key,
+						request.client_challenge));
+    return request;
+  }
+
+  CephXAuthenticate make_active_request()
+  {
+    CephXAuthenticate request{};
+    request.client_challenge = 1;
+    request.key = calculate_response(entity_auth.key,
+				     request.client_challenge);
+    return request;
+  }
+
+  int authenticate(CephxServiceHandler& handler,
+		   const CephXAuthenticate& request,
+		   CryptoKey *session_key = nullptr,
+		   bufferlist *result = nullptr)
+  {
+    bufferlist request_bl;
+    CephXRequestHeader header{CEPHX_GET_AUTH_SESSION_KEY};
+    encode(header, request_bl);
+    encode(request, request_bl);
+
+    auto request_iter = request_bl.cbegin();
+    bufferlist ignored_result;
+    AuthCapsInfo caps;
+    CryptoKey ignored_session_key;
+    return handler.handle_request(request_iter, 0,
+				  result ? result : &ignored_result, &caps,
+				  session_key ? session_key : &ignored_session_key,
+				  nullptr);
+  }
+
+  void install_rotating_secrets()
+  {
+    KeyServerData::Incremental incremental;
+    incremental.op = KeyServerData::AUTH_INC_SET_ROTATING;
+    ASSERT_TRUE(key_server.prepare_rotating_update(incremental.rotating_bl,
+						   false));
+    key_server.apply_data_incremental(incremental);
+  }
+
+  void install_mon_cap()
+  {
+    std::string cap = "allow *";
+    encode(cap, entity_auth.caps["mon"]);
+    encode(cap, entity_auth.caps["osd"]);
+    key_server.add_auth(entity_name, entity_auth);
+  }
+
+  void set_key_types(int active_type, int pending_type)
+  {
+    ASSERT_TRUE(key_server.generate_secret(entity_auth.key, active_type));
+    ASSERT_TRUE(key_server.generate_secret(entity_auth.pending_key,
+					   pending_type));
+    key_server.add_auth(entity_name, entity_auth);
+  }
+
+  void prepare_complete_auth()
+  {
+    install_rotating_secrets();
+    install_mon_cap();
+  }
+
+  void expect_session_key_types(const bufferlist& result,
+				CryptoKey& matched_key,
+				int expected_type)
+  {
+    auto result_iter = result.cbegin();
+    CephXResponseHeader header;
+    decode(header, result_iter);
+    ASSERT_EQ(CEPHX_GET_AUTH_SESSION_KEY, header.request_type);
+    ASSERT_EQ(0, header.status);
+
+    CephXTicketManager tickets(g_ceph_context);
+    ASSERT_TRUE(tickets.verify_service_ticket_reply(matched_key, result_iter));
+    auto& auth_ticket = tickets.get_handler(CEPH_ENTITY_TYPE_AUTH);
+    EXPECT_EQ(expected_type, auth_ticket.session_key.get_type());
+
+    bufferlist connection_secret;
+    bufferlist extra_tickets;
+    decode(connection_secret, result_iter);
+    decode(extra_tickets, result_iter);
+    EXPECT_TRUE(result_iter.end());
+    EXPECT_EQ(0, connection_secret.length());
+
+    auto extra_iter = extra_tickets.cbegin();
+    ASSERT_TRUE(tickets.verify_service_ticket_reply(auth_ticket.session_key,
+						     extra_iter));
+    EXPECT_TRUE(extra_iter.end());
+    EXPECT_EQ(expected_type,
+	      tickets.get_handler(CEPH_ENTITY_TYPE_OSD).session_key.get_type());
+  }
+
+  void expect_auth_unchanged()
+  {
+    EntityAuth current;
+    ASSERT_TRUE(key_server.get_auth(entity_name, current));
+    EXPECT_EQ(entity_auth.key, current.key);
+    EXPECT_EQ(entity_auth.pending_key, current.pending_key);
+  }
+
+  void expect_no_pending_use()
+  {
+    EXPECT_TRUE(key_server.get_used_pending_keys().empty());
+    expect_auth_unchanged();
+  }
+
+  void expect_pending_use()
+  {
+    const auto used_pending_keys = key_server.get_used_pending_keys();
+    ASSERT_EQ(1, used_pending_keys.size());
+    const auto found = used_pending_keys.find(entity_name);
+    ASSERT_NE(used_pending_keys.end(), found);
+    EXPECT_EQ(entity_auth.pending_key, found->second);
+    expect_auth_unchanged();
+  }
+};
+
+TEST_F(CephxServiceHandlerPendingKey, RejectsWrongResponse)
+{
+  auto handler = start_session(true);
+  CephXAuthenticate request{};
+  request.client_challenge = 1;
+  const auto active_response = calculate_response(entity_auth.key,
+						  request.client_challenge);
+  const auto pending_response = calculate_response(entity_auth.pending_key,
+						   request.client_challenge);
+  while (request.key == active_response || request.key == pending_response) {
+    ++request.key;
+  }
+
+  EXPECT_EQ(-EACCES, authenticate(*handler, request));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, RejectsPendingResponseWithoutOldTicket)
+{
+  auto handler = start_session(false);
+  auto request = make_pending_request();
+
+  EXPECT_EQ(-EACCES, authenticate(*handler, request));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey,
+       RejectsPendingResponseWithoutRotatingSecrets)
+{
+  auto handler = start_session(true);
+  auto request = make_pending_request();
+
+  EXPECT_EQ(-EIO, authenticate(*handler, request));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, RejectsPendingResponseWithoutCapabilities)
+{
+  install_rotating_secrets();
+  auto handler = start_session(true);
+  auto request = make_pending_request();
+
+  EXPECT_EQ(-EACCES, authenticate(*handler, request));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, RecordsPendingResponseOnSuccess)
+{
+  install_rotating_secrets();
+  install_mon_cap();
+  auto handler = start_session(true);
+  auto request = make_pending_request();
+
+  EXPECT_EQ(1, authenticate(*handler, request));
+  expect_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, DoesNotRecordActiveResponseOnSuccess)
+{
+  install_rotating_secrets();
+  install_mon_cap();
+  auto handler = start_session(true);
+  auto request = make_active_request();
+
+  EXPECT_EQ(1, authenticate(*handler, request));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey,
+       UsesMatchedSessionTypesForAesActiveAndAes256Pending)
+{
+  set_key_types(CEPH_CRYPTO_AES, CEPH_CRYPTO_AES256KRB5);
+  key_server.set_allowed_ciphers({CEPH_CRYPTO_AES, CEPH_CRYPTO_AES256KRB5});
+  prepare_complete_auth();
+
+  auto active_handler = start_session(true);
+  auto active_request = make_active_request();
+  active_request.other_keys = CEPH_ENTITY_TYPE_OSD;
+  CryptoKey active_session_key;
+  bufferlist active_result;
+  ASSERT_EQ(1, authenticate(*active_handler, active_request,
+			    &active_session_key, &active_result));
+  EXPECT_EQ(CEPH_CRYPTO_AES, active_session_key.get_type());
+  expect_session_key_types(active_result, entity_auth.key, CEPH_CRYPTO_AES);
+  expect_no_pending_use();
+
+  auto pending_handler = start_session(true);
+  auto pending_request = make_pending_request();
+  pending_request.other_keys = CEPH_ENTITY_TYPE_OSD;
+  CryptoKey pending_session_key;
+  bufferlist pending_result;
+  ASSERT_EQ(1, authenticate(*pending_handler, pending_request,
+			    &pending_session_key, &pending_result));
+  EXPECT_EQ(CEPH_CRYPTO_AES256KRB5, pending_session_key.get_type());
+  expect_session_key_types(pending_result, entity_auth.pending_key,
+			   CEPH_CRYPTO_AES256KRB5);
+  expect_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey,
+       UsesMatchedSessionTypesForAes256ActiveAndAesPending)
+{
+  set_key_types(CEPH_CRYPTO_AES256KRB5, CEPH_CRYPTO_AES);
+  key_server.set_allowed_ciphers({CEPH_CRYPTO_AES, CEPH_CRYPTO_AES256KRB5});
+  prepare_complete_auth();
+
+  auto active_handler = start_session(true);
+  auto active_request = make_active_request();
+  active_request.other_keys = CEPH_ENTITY_TYPE_OSD;
+  CryptoKey active_session_key;
+  bufferlist active_result;
+  ASSERT_EQ(1, authenticate(*active_handler, active_request,
+			    &active_session_key, &active_result));
+  EXPECT_EQ(CEPH_CRYPTO_AES256KRB5, active_session_key.get_type());
+  expect_session_key_types(active_result, entity_auth.key,
+			   CEPH_CRYPTO_AES256KRB5);
+  expect_no_pending_use();
+
+  auto pending_handler = start_session(true);
+  auto pending_request = make_pending_request();
+  pending_request.other_keys = CEPH_ENTITY_TYPE_OSD;
+  CryptoKey pending_session_key;
+  bufferlist pending_result;
+  ASSERT_EQ(1, authenticate(*pending_handler, pending_request,
+			    &pending_session_key, &pending_result));
+  EXPECT_EQ(CEPH_CRYPTO_AES, pending_session_key.get_type());
+  expect_session_key_types(pending_result, entity_auth.pending_key,
+			   CEPH_CRYPTO_AES);
+  expect_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, RejectsDisallowedPendingCipher)
+{
+  set_key_types(CEPH_CRYPTO_AES256KRB5, CEPH_CRYPTO_AES);
+  key_server.set_allowed_ciphers({CEPH_CRYPTO_AES256KRB5});
+  prepare_complete_auth();
+
+  auto active_handler = start_session(true);
+  EXPECT_EQ(1, authenticate(*active_handler, make_active_request()));
+  expect_no_pending_use();
+
+  auto pending_handler = start_session(true);
+  EXPECT_EQ(-EACCES, authenticate(*pending_handler, make_pending_request()));
+  expect_no_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, TriesAllowedPendingAfterDisallowedActive)
+{
+  set_key_types(CEPH_CRYPTO_AES, CEPH_CRYPTO_AES256KRB5);
+  key_server.set_allowed_ciphers({CEPH_CRYPTO_AES256KRB5});
+  prepare_complete_auth();
+
+  auto active_handler = start_session(true);
+  EXPECT_EQ(-EACCES, authenticate(*active_handler, make_active_request()));
+  expect_no_pending_use();
+
+  auto pending_handler = start_session(true);
+  EXPECT_EQ(1, authenticate(*pending_handler, make_pending_request()));
+  expect_pending_use();
+}
+
+TEST_F(CephxServiceHandlerPendingKey, RejectsBothDisallowedCiphers)
+{
+  set_key_types(CEPH_CRYPTO_AES, CEPH_CRYPTO_AES256KRB5);
+  key_server.set_allowed_ciphers({});
+  prepare_complete_auth();
+
+  auto active_handler = start_session(true);
+  EXPECT_EQ(-EACCES, authenticate(*active_handler, make_active_request()));
+  expect_no_pending_use();
+
+  auto pending_handler = start_session(true);
+  EXPECT_EQ(-EACCES, authenticate(*pending_handler, make_pending_request()));
+  expect_no_pending_use();
+}
